FROM python:3.11-slim

LABEL maintainer="Diogo Ribeiro <dfr@esmad.ipp.pt>"
LABEL description="PSOD Development Environment"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    graphviz \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app/

RUN python -m pip install --upgrade "pip>=26.2" "setuptools>=83" wheel && \
    python -m pip install -e ".[dev,test,viz,docs,benchmark]" && \
    python -m pip install jupyterlab ipykernel

RUN mkdir -p /data /models /logs /notebooks /root/.jupyter && \
    printf '%s\n' \
      'c.ServerApp.token = ""' \
      'c.ServerApp.password = ""' \
      > /root/.jupyter/jupyter_server_config.py

EXPOSE 8888

CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]
